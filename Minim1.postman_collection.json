{
  "info": {
    "name": "Minim1 - Shop API",
    "description": "Colección para probar el servicio REST del Mínimo 1. Ejecutar en orden (Runner) con el servidor recién arrancado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Listar productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/shop/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shop",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Productos por precio (ascendente)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/shop/products/price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shop",
            "products",
            "price"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Ordenado ascendente por precio\", function () {",
              "  var p = pm.response.json();",
              "  for (var i = 1; i < p.length; i++) { pm.expect(p[i].price).to.be.at.least(p[i-1].price); }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Añadir producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/shop/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shop",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"W1\",\n  \"name\": \"Aigua\",\n  \"price\": 1.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
